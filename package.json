{
  "name": "equalityohio-web",
  "private": true,
  "version": "0.1.0",
  "description": "Equality Ohio website redesign. Next.js on Vercel; static pages served from public/ until each is ported to the App Router. Supabase-backed forms arrive in Phase 2.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pages:build": "node scripts/build-pages.mjs",
    "check:pages": "node scripts/build-pages.mjs --check",
    "check:links": "node scripts/check-links.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "assets": "node scripts/art/generate-assets.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "lint:a11y": "playwright test tests/e2e/a11y.spec.mjs"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "sharp": "^0.35.5",
    "wawoff2": "^2.0.1"
  }
}
