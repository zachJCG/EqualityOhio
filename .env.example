# Copy to .env.local for local work. Never commit real values: this repo is
# public, and every secret lives in Vercel (and GitHub Actions secrets for CI).
# `next start`/`next dev` and the Playwright suite (tests/e2e/support/env.mjs)
# load the same files, so a value here reaches the server and the e2e tests
# alike; the shell still wins. The node tests (`npm test`) read only the
# shell, so pass EO_TODAY on the command line.

# --- Read by the site ---------------------------------------------------------

# Staging gate password (lib/preview-gate.mjs, read by middleware.js and
# /api/gate). Server only. Falls back to EO2026 when unset; set it on every
# Vercel environment to rotate, which signs every browser out. Unused once
# lib/site.mjs LAUNCHED is true (the middleware passes everything through and
# /api/gate answers 404); delete with the gate after launch.
STAGING_PASSWORD=

# Set by Vercel, never by hand: "production", "preview" or "development".
# Indexing (robots.txt, X-Robots-Tag) is allowed only when LAUNCHED is true
# and this is "production"; "preview" also allows the Vercel toolbar in the CSP.
# The e2e suite expects an indexable robots.txt from a local build only when
# this was "production" at build time and in the test run.
# VERCEL_ENV=

# --- Read by the tests and tools ------------------------------------------------

# Check content freshness as of another day (YYYY-MM-DD), e.g. launch day:
#   EO_TODAY=2026-11-20 npm test
# EO_TODAY=

# Run the Playwright suite against a deployment instead of a local `next start`.
# PLAYWRIGHT_BASE_URL=https://<preview>.vercel.app
# Local port for the suite's `next start` (default 3100).
# PLAYWRIGHT_PORT=3100
# A local Chromium (defaults to /opt/pw-browsers/chromium when present).
# PLAYWRIGHT_CHROMIUM_PATH=
# Sent as x-vercel-protection-bypass when Vercel Deployment Protection guards
# the preview under test.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Write each share card's SVG source to this directory (npm run assets).
# EO_ART_DEBUG=
